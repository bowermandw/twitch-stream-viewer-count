# Credentials — never commit these
.env

# Collected data, logs and cached tokens
data/*
!data/.gitkeep

# Generated charts
charts/*
!charts/.gitkeep

# Local notes: the real channels and their website URLs. The published site is
# public-read and unlisted, so its address is the only thing keeping it private
# — it does not belong in a public repo. docs/ itself stays committed for the
# README images.
docs/local/

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/

bruno/
