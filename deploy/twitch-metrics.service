# systemd unit for continuous polling on a Linux server.
#
#   sudo cp deploy/twitch-metrics.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now twitch-metrics
#   journalctl -u twitch-metrics -f
#
# Edit User, WorkingDirectory and the channel below to match your install.

[Unit]
Description=Twitch metrics poller
Documentation=https://github.com/bowermandw/twitch-stream-viewer-count
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twitch
Group=twitch
WorkingDirectory=/opt/twitch-metrics
ExecStart=/usr/bin/python3 -m twitchmetrics poll themeparkgiant

# Restart on crash, but back off so a persistent failure doesn't spin.
Restart=on-failure
RestartSec=30

# The poller survives API errors itself; this is for the unexpected.
StandardOutput=journal
StandardError=journal

# Only the data directory needs to be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/twitch-metrics/data /opt/twitch-metrics/charts

[Install]
WantedBy=multi-user.target
