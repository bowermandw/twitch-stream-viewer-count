# systemd TEMPLATE unit — one instance per YouTube channel.
#
# The name after the @ is passed as the channel handle, so a single file serves
# any number of channels. Use the @name from the channel URL, without the @:
#
#   sudo cp deploy/youtube-metrics@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now youtube-metrics@testchannel
#
#   systemctl status youtube-metrics@testchannel
#   journalctl -u youtube-metrics@testchannel -f
#   systemctl stop 'youtube-metrics@*'
#
# This runs alongside twitch-metrics@.service rather than replacing it: the two
# write different files (data/youtube_<channel>.csv here) and use different
# credentials, so the same machine can poll a creator on both platforms.
#
# QUOTA. Every sample costs three of the 10,000 YouTube API units a day, so the
# interval is a budget rather than a preference. The default 60 seconds spends
# 4,320 a day: room for a second instance, but not a third. For more than two,
# stretch it with Environment=YOUTUBE_INTERVAL=180 in a drop-in, or add
# --interval to ExecStart below. Under 60 seconds is refused.
#
# BEFORE ENABLING, edit User, Group and WorkingDirectory below to match your
# install. The values here are placeholders and WILL fail if left as-is:
#
#   User=twitch does not exist by default -> systemd exits 217/USER before
#   running anything, and the service restart-loops with no Python output.
#
# Create the account:      useradd -r -s /usr/sbin/nologin twitch
# Or run as yourself:      set User= and Group= to an existing account.
#
# If the checkout lives under /root or /home, also set ProtectHome=no —
# read-only would stop the poller writing its CSV.
#
# Confirm what systemd resolved:
#   systemctl show -p User -p WorkingDirectory youtube-metrics@yourchannel

[Unit]
Description=YouTube metrics poller for %i
Documentation=https://github.com/bowermandw/twitch-stream-viewer-count
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=twitch
Group=twitch
WorkingDirectory=/opt/twitch-metrics
ExecStart=/usr/bin/python3 -m twitchmetrics youtube %i

# Restart on crash, backing off so a persistent failure doesn't spin.
Restart=on-failure
RestartSec=30

# SIGTERM is handled: the poller finishes its current sample and exits 0.
# It never needs the full grace period, so a short one surfaces real hangs.
KillSignal=SIGTERM
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal

# Only the data and charts directories need to be writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/twitch-metrics/data /opt/twitch-metrics/charts

[Install]
WantedBy=multi-user.target
