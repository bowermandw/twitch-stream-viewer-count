# Get these from https://dev.twitch.tv/console/apps
# Register an app, then click Manage -> New Secret.
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Optional: default channel when none is given on the command line.
# Overridden by passing a channel as the first argument.
#TWITCH_CHANNEL=your_channel_name

# Optional: seconds between samples (default 300, minimum 10).
# Overridden by --interval.
#TWITCH_INTERVAL=60

# --- YouTube (optional) ---------------------------------------------------
# Only the `youtube` command needs this; every Twitch command works without it.
# Create a key at https://console.cloud.google.com/apis/credentials, and enable
# "YouTube Data API v3" for the same project. An API key is enough — the two
# metrics collected are both public, so there is no sign-in and no OAuth.
#YOUTUBE_API_KEY=your_api_key_here

# Optional: default YouTube channel. The @name from the channel URL, with or
# without the @, or a raw UC… channel id. Separate from TWITCH_CHANNEL because
# a creator's handles on the two platforms need not match.
# Overridden by passing a channel as the first argument.
#YOUTUBE_CHANNEL=themeparkgiant

# Optional: seconds between YouTube samples (default 60, minimum 60).
# Separate from TWITCH_INTERVAL because this one is a quota budget, not a rate
# limit: each sample costs 3 of the 10,000 API units a day, so 60s is 4,320 —
# room for two channels, not three. Overridden by --interval.
#YOUTUBE_INTERVAL=120

# --- Daily report to Google Drive (optional) ------------------------------
# Created by `twitch-metrics drive --setup`, which verifies them first.
#GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=GOCSPX-your_client_secret_here

# Optional: top-level Drive folder for the uploads (default "Twitch Metrics").
#GOOGLE_DRIVE_FOLDER=Twitch Metrics

# Optional: loopback URL the browser is redirected back to during `drive --auth`.
# Port 3000 is shared with `auth`, so change this if you need both at once.
#GOOGLE_REDIRECT_URI=http://localhost:3000

# Optional: channels the daily report covers. Normally left unset, so the list
# comes from the enabled twitch-metrics@ systemd instances instead.
#TWITCH_DAILY_CHANNELS=themeparkgiant,prgskidmark
